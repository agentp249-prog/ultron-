# Piper model name.
# Change this if you have a different Piper model installed.
PIPER_MODEL = "en_US-lessac-low"

BASE_DIR = Path(__file__).resolve().parent
VOICE_DIR = BASE_DIR / "voice_output"
VOICE_DIR.mkdir(exist_ok=True)

