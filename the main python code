# ============================================================
# MAIN
# ============================================================

def main():

    print_banner()

    if not GEMINI_API_KEY:
        print(
            "\n⚠️ GEMINI_API_KEY is not configured."
        )

    if TELEGRAM_TOKEN:
        threading.Thread(
            target=start_telegram,
            daemon=True
        ).start()
    else:
        print(
            "Telegram: DISABLED"
        )

    print(
        "\nULTRON V9 READY."
    )

    print(
        "Type a command or type 'voice' to speak."
    )

    print(
        "Type 'exit' to shut down.\n"
    )

    while ultron.running:

        try:

            command = input("YOU > ").strip()

            if not command:
                continue

            if command.lower() in (
                "voice",
                "listen",
                "voice command",
            ):

                command = ultron.listen()

                if not command:
                    continue

            ultron.handle(command)

        except KeyboardInterrupt:

            print(
                "\n\nULTRON shutting down."
            )
            break

        except Exception as e:

            print(
                f"\n[ERROR] {e}"
            )


if __name__ == "__main__":
    main()
